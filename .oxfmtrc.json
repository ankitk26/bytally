{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"useTabs": true,
	"tabWidth": 2,
	"printWidth": 80,
	"sortImports": {
		"newlinesBetween": false
	},
	"sortTailwindcss": {
		"stylesheet": "./src/styles.css",
		"functions": ["clsx", "cn"],
		"preserveWhitespace": true
	},
	"ignorePatterns": [
		"**/src/routeTree.gen.ts",
		"**/convex/_generated/**",
		"**/bun.lock"
	]
}
